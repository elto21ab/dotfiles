    "BTTUUID" : "B0D3371F-4C4A-4EB2-B700-5F4A27EA47A1",
    "BTTPredefinedActionType" : 206,
    "BTTPredefinedActionName" : "Execute Shell Script  or  Task",
    "BTTShellTaskActionScript" : "PID=`pgrep \"caffeinate\"`\n\nif [ -z \"$PID\" ]\nthen\n    echo Stopped\n    caffeinate -di > \/dev\/null 2>&1 &\nelse\n    echo Running\n    kill $PID\nfi",
