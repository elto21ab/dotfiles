    "BTTPredefinedActionName" : "Run Apple Script (async in background)",
    "BTTInlineAppleScript" : "tell application \"BetterTouchTool\"\r\tif is_app_running \"FaceTime\" then\r\t\ttell application \"System Events\"\r\t\t\ttell process \"Dock\"\r\t\t\t\ttry\r\t\t\t\t\tclick UI element \"FaceTime\" of list 1\r\t\t\t\tend try\r\t\t\tend tell\r\t\tend tell\r\telse\r\t\ttell application \"FaceTime\" to activate\r\tend if\nend tell\n\nreturn \"\"",
