    "BTTTriggerConfig" : {
      "BTTTouchBarItemPadding" : 20,
      "BTTTouchBarButtonColor" : "192.000000, 192.000000, 192.000000, 255.000000",
      "BTTTouchBarIconInvert" : false,
      "BTTTouchBarItemPlacement" : 2,
      "BTTTouchBarAppleScriptStringRunOnInit" : false,
      "BTTTouchBarAlwaysShowButton" : false,
      "BTTTouchBarButtonFontSizeLine2" : 3,
      "BTTTouchBarButtonHoverColor" : "248.880000, 146.115000, 128.010000, 181.050000",
      "BTTTouchBarButtonHeight" : 15,
      "BTTTouchBarButtonWidth" : 100,
      "BTTTouchBarScriptUpdateInterval" : 1,
      "BTTTouchBarItemIconHeight" : 22,
      "BTTTouchBarButtonTextAlignment" : 0,
      "BTTShellScriptDontTrimWhitepsace" : 0,
      "BTTTouchBarAlternateBackgroundColor" : "75.323769, 75.323769, 75.323769, 255.000000",
      "BTTTBWidgetWidth" : 400,
      "BTTTouchBarBorderColor" : "255.000000, 255.000000, 255.000000, 255.000000",
      "BTTTouchBarItemIconWidth" : 22,
      "BTTTouchBarFreeSpaceBeforeButton" : 0,
      "BTTTouchBarButtonName" : "\n1\n2\n3",
      "BTTTouchBarIconTextOffset" : 5,
      "BTTTouchBarFontColor" : "0.000000, 0.000000, 0.000000, 255.000000",
      "BTTTouchBarShellScriptString" : "#!\/bin\/zsh\n\n# --- Paths ---\nYABAI_PATH=\"\/opt\/homebrew\/bin\/yabai\"\nJQ_PATH=\"\/opt\/homebrew\/bin\/jq\"\nBC_PATH=\"\/usr\/bin\/bc\"\n$\n# --- Configuration for Visuals ---\nCANVAS_WIDTH_CHARS=12\nSPACE_SEPARATOR_CHAR=\"\t\" \nEMPTY_CANVAS_CHAR=\"  \"      # Using Light Shade for empty cells\nFILLED_CANVAS_CHAR=\"■\"     # Existing filled cell character\n\n# --- JQ Filter for selecting windows ---\nJQ_WINDOW_FILTER='.[] | select(.\"is-minimized\" == false and .\"is-hidden\" == false and .\"sub-role\" != \"AXDialog\" and .app != \"\")'\n\n# --- Get Space Indices ---\nSPACE_INDICES_STRING=$($YABAI_PATH -m query --spaces | $JQ_PATH -r '.[] | select(.\"is-native-fullscreen\" == false) | .index') #and .type == \"bsp\"\nlocal -a space_indices_array\nif [ -n \"$SPACE_INDICES_STRING\" ]; then\n    space_indices_array=(\"${(f)SPACE_INDICES_STRING}\")\n    space_indices_array=(${space_indices_array[@]\/#''}) \nfi\nACTUAL_SPACE_INDICES_COUNT=${#space_indices_array[@]:-0}\n\nif [[ \"$ACTUAL_SPACE_INDICES_COUNT\" -eq 0 ]]; then\n  printf \"NoSpaces\\n\"\n  exit 0\nfi\n\nOUTPUT_STRING_L0=\"\"; OUTPUT_STRING_L1=\"\"; OUTPUT_STRING_L2=\"\"; OUTPUT_STRING_L3=\"\"\n\nLINE_BREAK_POINT1_NORM=0.25 \nLINE_BREAK_POINT2_NORM=0.50 \nLINE_BREAK_POINT3_NORM=0.75 \n\nfor CURRENT_SPACE_INDEX in \"${space_indices_array[@]}\"; do\n  if [ -z \"$CURRENT_SPACE_INDEX\" ]; then continue; fi\n\n  DISPLAY_INFO=$($YABAI_PATH -m query --displays --space $CURRENT_SPACE_INDEX | $JQ_PATH '.[0]')\n  if [ -z \"$DISPLAY_INFO\" ] || [ \"$DISPLAY_INFO\" = \"null\" ]; then DISPLAY_INFO=$($YABAI_PATH -m query --displays | $JQ_PATH '.[0]'); fi\n  if [ -z \"$DISPLAY_INFO\" ] || [ \"$DISPLAY_INFO\" = \"null\" ]; then DISPLAY_INFO='{\"frame\":{\"x\":0,\"w\":1920,\"h\":1080}}'; fi\n  \n  SPACE_DISPLAY_X_RAW=$(echo \"$DISPLAY_INFO\" | $JQ_PATH '.frame.x \/\/ 0'); SPACE_DISPLAY_W_RAW=$(echo \"$DISPLAY_INFO\" | $JQ_PATH '.frame.w \/\/ 1'); SPACE_DISPLAY_H_RAW=$(echo \"$DISPLAY_INFO\" | $JQ_PATH '.frame.h \/\/ 1')\n  SPACE_DISPLAY_X=$(printf \"%.0f\" \"$SPACE_DISPLAY_X_RAW\"); SPACE_DISPLAY_W=$(printf \"%.0f\" \"$SPACE_DISPLAY_W_RAW\"); SPACE_DISPLAY_H=$(printf \"%.0f\" \"$SPACE_DISPLAY_H_RAW\")\n  if (( SPACE_DISPLAY_W == 0 )); then SPACE_DISPLAY_W=1; fi; if (( SPACE_DISPLAY_H == 0 )); then SPACE_DISPLAY_H=1; fi\n\n  declare -a canvas_l0 canvas_l1 canvas_l2 canvas_l3\n  for i in {1..$CANVAS_WIDTH_CHARS}; do\n      canvas_l0[$i]=\"$EMPTY_CANVAS_CHAR\"; canvas_l1[$i]=\"$EMPTY_CANVAS_CHAR\"\n      canvas_l2[$i]=\"$EMPTY_CANVAS_CHAR\"; canvas_l3[$i]=\"$EMPTY_CANVAS_CHAR\"\n  done\n  \n  while IFS= read -r window_json; do\n    if [ -z \"$window_json\" ]; then continue; fi\n\n    WIN_X_RAW=$(echo \"$window_json\" | $JQ_PATH '.frame.x'); WIN_W_RAW=$(echo \"$window_json\" | $JQ_PATH '.frame.w'); WIN_Y_RAW=$(echo \"$window_json\" | $JQ_PATH '.frame.y'); WIN_H_RAW=$(echo \"$window_json\" | $JQ_PATH '.frame.h')\n    WIN_X=$(printf \"%.0f\" \"$WIN_X_RAW\"); WIN_W=$(printf \"%.0f\" \"$WIN_W_RAW\"); WIN_Y=$(printf \"%.0f\" \"$WIN_Y_RAW\"); WIN_H=$(printf \"%.0f\" \"$WIN_H_RAW\")\n    \n    RELATIVE_WIN_X=$((WIN_X - SPACE_DISPLAY_X))\n    \n    BC_START_CMD=\"scale=4; ($RELATIVE_WIN_X \/ $SPACE_DISPLAY_W) * $CANVAS_WIDTH_CHARS\"; BC_WIDTH_CMD=\"scale=4; ($WIN_W \/ $SPACE_DISPLAY_W) * $CANVAS_WIDTH_CHARS\"\n    START_CHAR_RAW=$(echo \"$BC_START_CMD\" | $BC_PATH); WIDTH_CHARS_RAW=$(echo \"$BC_WIDTH_CMD\" | $BC_PATH)\n    VALID_NUMBER_REGEX='^-?([0-9]*[.,])?[0-9]+$'; if ! [[ \"$START_CHAR_RAW\" =~ $VALID_NUMBER_REGEX ]]; then START_CHAR_RAW=0; fi; if ! [[ \"$WIDTH_CHARS_RAW\" =~ $VALID_NUMBER_REGEX ]]; then WIDTH_CHARS_RAW=0; fi\n    \n    \n    # …existing code up to computing START_CHAR_RAW, WIDTH_CHARS_RAW…\n\n    # floor the start\n    START_CHAR=$(echo \"scale=0; $START_CHAR_RAW \/ 1\" | $BC_PATH)\n\n    # raw floating end\n    RAW_END=$(echo \"$START_CHAR_RAW + $WIDTH_CHARS_RAW\" | $BC_PATH -l)\n\n    # decide ceil vs clamp\n    # does this window really hit the right edge?\n    SCREEN_RIGHT=$(( SPACE_DISPLAY_X + SPACE_DISPLAY_W ))\n    WINDOW_RIGHT=$(( WIN_X + WIN_W ))\n\n    if (( WINDOW_RIGHT >= SCREEN_RIGHT )); then\n    # true edge – clamp fully\n    END_CHAR=$CANVAS_WIDTH_CHARS\n    else\n    # interior window – always round _up_ so fractional gap comes through\n    # 1-cell “ceil” = int(raw_end) if raw_end is integer else int(raw_end)+1\n    # we can do that cheaply with bc: add (1−ε) then floor\n    END_CHAR=$(echo \"scale=0; ($RAW_END + 0.9999) \/ 1\" | $BC_PATH)\n    fi\n\n    WIDTH_CHARS=$(( END_CHAR - START_CHAR ))\n    # guarantee at least one char if non-zero width\n    if (( WIDTH_CHARS < 1 && $(echo \"$WIDTH_CHARS_RAW > 0\" | $BC_PATH -l) )); then\n    WIDTH_CHARS=1\n    fi\n    # …rest of existing code…\n\n    # START_CHAR=$(printf \"%.0f\" \"$START_CHAR_RAW\"); WIDTH_CHARS=$(printf \"%.0f\" \"$WIDTH_CHARS_RAW\")\n    # if (( $(echo \"$WIDTH_CHARS_RAW > 0 && $WIDTH_CHARS < 1\" | $BC_PATH -l) )); then WIDTH_CHARS=1; elif (( WIDTH_CHARS == 0 && $(echo \"$WIDTH_CHARS_RAW > 0\" | $BC_PATH -l) )); then WIDTH_CHARS=1; fi\n\n    PAINT_L0=false; PAINT_L1=false; PAINT_L2=false; PAINT_L3=false\n    BC_YN_CMD=\"scale=4; $WIN_Y \/ $SPACE_DISPLAY_H\"; BC_HN_CMD=\"scale=4; $WIN_H \/ $SPACE_DISPLAY_H\"\n    WINDOW_Y_NORM_RAW=$(echo \"$BC_YN_CMD\" | $BC_PATH); WINDOW_H_NORM_RAW=$(echo \"$BC_HN_CMD\" | $BC_PATH)\n    if ! [[ \"$WINDOW_Y_NORM_RAW\" =~ $VALID_NUMBER_REGEX ]]; then WINDOW_Y_NORM_RAW=0; fi; if ! [[ \"$WINDOW_H_NORM_RAW\" =~ $VALID_NUMBER_REGEX ]]; then WINDOW_H_NORM_RAW=0; fi\n    WINDOW_BOTTOM_NORM_RAW=$(echo \"scale=4; $WINDOW_Y_NORM_RAW + $WINDOW_H_NORM_RAW\" | $BC_PATH)\n    if ! [[ \"$WINDOW_BOTTOM_NORM_RAW\" =~ $VALID_NUMBER_REGEX ]]; then WINDOW_BOTTOM_NORM_RAW=$WINDOW_Y_NORM_RAW; fi\n\n    if (( $(echo \"$WINDOW_Y_NORM_RAW < $LINE_BREAK_POINT1_NORM && $WINDOW_BOTTOM_NORM_RAW > 0.0\" | $BC_PATH -l) )); then PAINT_L0=true; fi\n    if (( $(echo \"$WINDOW_Y_NORM_RAW < $LINE_BREAK_POINT2_NORM && $WINDOW_BOTTOM_NORM_RAW > $LINE_BREAK_POINT1_NORM\" | $BC_PATH -l) )); then PAINT_L1=true; fi\n    if (( $(echo \"$WINDOW_Y_NORM_RAW < $LINE_BREAK_POINT3_NORM && $WINDOW_BOTTOM_NORM_RAW > $LINE_BREAK_POINT2_NORM\" | $BC_PATH -l) )); then PAINT_L2=true; fi\n    if (( $(echo \"$WINDOW_Y_NORM_RAW < 1.0 && $WINDOW_BOTTOM_NORM_RAW > $LINE_BREAK_POINT3_NORM\" | $BC_PATH -l) )); then PAINT_L3=true; fi\n    \n    for ((c = 0; c < WIDTH_CHARS; c++)); do\n      POS=$((START_CHAR + c + 1))\n      if ((POS >= 1 && POS <= CANVAS_WIDTH_CHARS)); then\n        if $PAINT_L0; then canvas_l0[$POS]=\"$FILLED_CANVAS_CHAR\"; fi\n        if $PAINT_L1; then canvas_l1[$POS]=\"$FILLED_CANVAS_CHAR\"; fi\n        if $PAINT_L2; then canvas_l2[$POS]=\"$FILLED_CANVAS_CHAR\"; fi\n        if $PAINT_L3; then canvas_l3[$POS]=\"$FILLED_CANVAS_CHAR\"; fi\n      fi\n    done\n  done < <($YABAI_PATH -m query --windows --space $CURRENT_SPACE_INDEX | $JQ_PATH -c \"$JQ_WINDOW_FILTER\")\n  \n  temp_canvas_str_l0=$(printf \"%s\" \"${canvas_l0[@]}\")\n  VISUAL_REP_L0=$(printf \"%-${CANVAS_WIDTH_CHARS}s\" \"$temp_canvas_str_l0\" | sed \"s\/ \/$EMPTY_CANVAS_CHAR\/g\")\n\n  temp_canvas_str_l1=$(printf \"%s\" \"${canvas_l1[@]}\")\n  VISUAL_REP_L1=$(printf \"%-${CANVAS_WIDTH_CHARS}s\" \"$temp_canvas_str_l1\" | sed \"s\/ \/$EMPTY_CANVAS_CHAR\/g\")\n\n  temp_canvas_str_l2=$(printf \"%s\" \"${canvas_l2[@]}\")\n  VISUAL_REP_L2=$(printf \"%-${CANVAS_WIDTH_CHARS}s\" \"$temp_canvas_str_l2\" | sed \"s\/ \/$EMPTY_CANVAS_CHAR\/g\")\n\n  temp_canvas_str_l3=$(printf \"%s\" \"${canvas_l3[@]}\")\n  VISUAL_REP_L3=$(printf \"%-${CANVAS_WIDTH_CHARS}s\" \"$temp_canvas_str_l3\" | sed \"s\/ \/$EMPTY_CANVAS_CHAR\/g\")\n\n  _L0_SEGMENT=\"[${VISUAL_REP_L0}]\" \n  OUTPUT_STRING_L0=\"${OUTPUT_STRING_L0}${_L0_SEGMENT}${SPACE_SEPARATOR_CHAR}\"\n  _L1_SEGMENT=\"[${VISUAL_REP_L1}]\"; OUTPUT_STRING_L1=\"${OUTPUT_STRING_L1}${_L1_SEGMENT}${SPACE_SEPARATOR_CHAR}\"\n  _L2_SEGMENT=\"[${VISUAL_REP_L2}]\"; OUTPUT_STRING_L2=\"${OUTPUT_STRING_L2}${_L2_SEGMENT}${SPACE_SEPARATOR_CHAR}\"\n  _L3_SEGMENT=\"[${VISUAL_REP_L3}]\"; OUTPUT_STRING_L3=\"${OUTPUT_STRING_L3}${_L3_SEGMENT}${SPACE_SEPARATOR_CHAR}\"\ndone\n\nif [ -n \"$SPACE_SEPARATOR_CHAR\" ]; then\n    OUTPUT_STRING_L0=\"${OUTPUT_STRING_L0%${SPACE_SEPARATOR_CHAR}}\"\n    OUTPUT_STRING_L1=\"${OUTPUT_STRING_L1%${SPACE_SEPARATOR_CHAR}}\"\n    OUTPUT_STRING_L2=\"${OUTPUT_STRING_L2%${SPACE_SEPARATOR_CHAR}}\"\n    OUTPUT_STRING_L3=\"${OUTPUT_STRING_L3%${SPACE_SEPARATOR_CHAR}}\"\nfi\n\n_ASSEMBLED_OUTPUT=\"${OUTPUT_STRING_L0}\"\nif [[ \"$OUTPUT_STRING_L1\" == *$FILLED_CANVAS_CHAR* ]]; then _ASSEMBLED_OUTPUT=\"${_ASSEMBLED_OUTPUT}\\n${OUTPUT_STRING_L1}\"; fi\nif [[ \"$OUTPUT_STRING_L2\" == *$FILLED_CANVAS_CHAR* ]]; then _ASSEMBLED_OUTPUT=\"${_ASSEMBLED_OUTPUT}\\n${OUTPUT_STRING_L2}\"; fi\nif [[ \"$OUTPUT_STRING_L3\" == *$FILLED_CANVAS_CHAR* ]]; then _ASSEMBLED_OUTPUT=\"${_ASSEMBLED_OUTPUT}\\n${OUTPUT_STRING_L3}\"; fi\n\nprintf \"%b\\n\" \"$_ASSEMBLED_OUTPUT\"",
      "BTTTouchBarOnlyShowIcon" : false,
      "BTTTouchBarFreeSpaceAfterButton" : 5,
      "BTTTouchBarButtonFontSize" : 3
    }
  },
