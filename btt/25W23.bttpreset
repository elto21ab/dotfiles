    "BTTInlineAppleScript" : "tell application \"BetterTouchTool\"\r\tif is_app_running \"WhatsApp\" then\r\t\ttell application \"System Events\"\r\t\t\ttell process \"Dock\"\r\t\t\t\ttry\r\t\t\t\t\tclick UI element \"WhatsApp\" of list 1\r\t\t\t\tend try\r\t\t\tend tell\r\t\tend tell\r\telse\r\t\ttell application \"WhatsApp\" to activate\r\tend if\nend tell\n\nreturn \"\"",
