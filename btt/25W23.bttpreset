      "BTTTouchBarScriptUpdateInterval" : 5,
      "BTTTouchBarItemIconHeight" : 20,
      "BTTTouchBarBatteryHideOnCharging" : false,
      "BTTTouchBarButtonTextAlignment" : 0,
      "BTTTouchBarAlternateBackgroundColor" : "75.323769, 75.323769, 75.323769, 255.000000",
      "BTTTouchBarAppleScriptUsePath" : 0,
      "BTTTBWidgetWidth" : 400,
      "BTTTouchBarDefaultPlayer" : 0,
      "BTTTouchBarItemIconWidth" : 20,
      "BTTTouchBarHideWhenNoPlayer" : false,
      "BTTTouchBarButtonFontSize" : 15,
      "BTTTouchBarFontColor" : "255.000000, 255.000000, 255.000000, 255.000000",
      "BTTTouchBarHideCover" : 0,
      "BTTTouchBarAppleScriptString" : "tell application \"BetterTouchTool\" to set dndEnabled to get_number_variable \"SystemDoNotDisturbState\"\r\rif dndEnabled is 0 then\r\ttell application \"BetterTouchTool\"\r\t\tset badgeNumber to get_dock_badge_for \"WhatsApp\" update_interval 5\r\t\tset handoffDevice to get_dock_badge_for \"WhatsApp-handoff\" update_interval 5\r\tend tell\r\tif badgeNumber is not missing value and handoffDevice is missing value then\r\t\ttell application \"BetterTouchTool\"\r\t\t\tif is_app_running \"WhatsApp\" then\r\t\t\t\treturn badgeNumber\r\t\t\telse\r\t\t\t\treturn \"\"\r\t\t\tend if\r\t\tend tell\r\telse if handoffDevice is not missing value then\r\t\tif handoffDevice contains \"iPhone\" then\r\t\t\treturn \"iPhone\"\r\t\telse if handoffDevice contains \"iPad\" then\r\t\t\treturn \"iPad\"\r\t\telse if handoffDevice contains \"watch\" then\r\t\t\treturn \"Watch\"\r\t\telse if handoffDevice contains \"Mac\" then\r\t\t\treturn \"Mac\"\r\t\tend if\r\telse\r\t\treturn \"\"\r\tend if\relse\r\treturn \"\"\rend if",
      "BTTTouchBarItemPadding" : -8
    }
