    "BTTWidgetName" : "FaceTime",
    "BTTKeySequence" : {

    },
    "BTTTriggerConfig" : {
      "BTTTouchBarOnlyShowIcon" : false,
      "BTTTouchBarIconTextOffset" : 5,
      "BTTTouchBarButtonCornerRadius" : 6,
      "BTTTouchBarBringPlayerToFront" : 0,
      "BTTTouchBarFreeSpaceAfterButton" : 5,
      "BTTTouchBarButtonColor" : "0.000000, 194.344600, 0.000000, 255.000000",
      "BTTTouchBarEmojiHideBackButton" : false,
      "BTTTouchBarItemPlacement" : 1,
      "BTTTouchBarAppleScriptStringRunOnInit" : false,
      "BTTTouchBarAlwaysShowButton" : false,
      "BTTTouchBarHideWhenPaused" : 0,
      "BTTScriptType" : 0,
      "BTTTouchBarButtonWidth" : 100,
      "BTTTouchBarScriptUpdateInterval" : 5,
      "BTTTouchBarItemIconHeight" : 23,
      "BTTTouchBarBatteryHideOnCharging" : false,
      "BTTTouchBarButtonTextAlignment" : 0,
      "BTTTouchBarAlternateBackgroundColor" : "75.323769, 75.323769, 75.323769, 255.000000",
      "BTTTouchBarAppleScriptUsePath" : 0,
      "BTTTBWidgetWidth" : 400,
      "BTTTouchBarDefaultPlayer" : 0,
      "BTTTouchBarItemIconWidth" : 23,
      "BTTTouchBarHideWhenNoPlayer" : false,
      "BTTTouchBarButtonFontSize" : 15,
      "BTTTouchBarFontColor" : "255.000000, 255.000000, 255.000000, 255.000000",
      "BTTTouchBarHideCover" : 0,
      "BTTTouchBarAppleScriptString" : "tell application \"BetterTouchTool\" to set dndEnabled to get_number_variable \"SystemDoNotDisturbState\"\r\rif dndEnabled is 0 then\r\ttell application \"BetterTouchTool\"\r\t\tset badgeNumber to get_dock_badge_for \"FaceTime\" update_interval 5\r\t\tset handoffDevice to get_dock_badge_for \"FaceTime-handoff\" update_interval 5\r\tend tell\r\tif badgeNumber is not missing value and handoffDevice is missing value then\r\t\ttell application \"BetterTouchTool\"\r\t\t\tif is_app_running \"FaceTime\" then\r\t\t\t\treturn badgeNumber\r\t\t\telse\r\t\t\t\treturn \"\"\r\t\t\tend if\r\t\tend tell\r\telse if handoffDevice is not missing value then\r\t\tif handoffDevice contains \"iPhone\" then\r\t\t\treturn \"iPhone\"\r\t\telse if handoffDevice contains \"iPad\" then\r\t\t\treturn \"iPad\"\r\t\telse if handoffDevice contains \"watch\" then\r\t\t\treturn \"Watch\"\r\t\telse if handoffDevice contains \"Mac\" then\r\t\t\treturn \"Mac\"\r\t\tend if\r\telse\r\t\treturn \"\"\r\tend if\relse\r\treturn \"\"\rend if",
      "BTTTouchBarItemPadding" : -8
    }
  },
  {
    "BTTActionCategory" : 0,
    "BTTLastUpdatedAt" : 1748871891.4420991,
    "BTTTriggerType" : 639,
    "BTTTriggerTypeDescriptionReadOnly" : "Apple Script \/ JavaScript Widget",
    "BTTTriggerTypeDescription" : "iMessage",
    "BTTTriggerClass" : "BTTTriggerTypeTouchBar",
    "BTTUUID" : "F3668E7B-4623-4B29-A9DF-7FF5ECCA710C",
    "BTTPredefinedActionType" : 195,
    "BTTPredefinedActionName" : "Run Apple Script (async in background)",
    "BTTInlineAppleScript" : "tell application \"BetterTouchTool\"\r\tif is_app_running \"Messages\" then\r\t\ttell application \"System Events\"\r\t\t\ttell process \"Dock\"\r\t\t\t\ttry\r\t\t\t\t\tclick UI element \"Messages\" of list 1\r\t\t\t\tend try\r\t\t\tend tell\r\t\tend tell\r\telse\r\t\ttell application \"Messages\" to activate\r\tend if\nend tell\n\nreturn \"\"",
    "BTTAlternateModifierKeys" : 1835008,
    "BTTEnabled" : 1,
    "BTTEnabled2" : 0,
    "BTTModifierMode" : 2,
    "BTTRequiredModifierKeys" : 1835008,
    "BTTOrder" : 33,
