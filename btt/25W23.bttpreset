    "BTTWidgetName" : "BusyCal",
    "BTTKeySequence" : {

    },
    "BTTTriggerConfig" : {
      "BTTTouchBarButtonColor" : "255.000000, 69.000000, 58.000000, 255.000000",
      "BTTTouchBarButtonTextAlignment" : 0,
      "BTTTouchBarButtonCornerRadius" : 6,
      "BTTTouchBarIconInvert" : false,
      "BTTTouchBarFreeSpaceAfterButton" : 5,
      "BTTTouchBarAppleScriptString" : "tell application \"BetterTouchTool\" to set dndEnabled to get_number_variable \"SystemDoNotDisturbState\"\r\rif dndEnabled is 0 then\r\ttell application \"BetterTouchTool\"\r\t\tset badgeNumber to get_dock_badge_for \"BusyCal\" update_interval 5\r\t\tset handoffDevice to get_dock_badge_for \"BusyCal-handoff\" update_interval 5\r\tend tell\r\tif badgeNumber is not missing value and handoffDevice is missing value then\r\t\ttell application \"BetterTouchTool\"\n    \t\tif is_app_running \"BusyCal\" then\r\t\t\t\treturn badgeNumber\r\t\t\telse\r\t\t\t\treturn \"\"\r\t\t\tend if\n\t\tend tell\r\telse if handoffDevice is not missing value then\r\t\tif handoffDevice contains \"iPhone\" then\r\t\t\treturn \"iPhone\"\r\t\telse if handoffDevice contains \"iPad\" then\r\t\t\treturn \"iPad\"\r\t\telse if handoffDevice contains \"watch\" then\r\t\t\treturn \"Watch\"\r\t\telse if handoffDevice contains \"Mac\" then\r\t\t\treturn \"Mac\"\r\t\tend if\r\telse\r\t\treturn \"\"\r\tend if\relse\r\treturn \"\"\rend if",
      "BTTTouchBarAppleScriptStringRunOnInit" : false,
      "BTTTouchBarButtonHeight" : 15,
      "BTTTouchBarBringPlayerToFront" : 0,
      "BTTTouchBarItemIconWidth" : 18,
