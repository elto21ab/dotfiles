      "BTTTouchBarAppleScriptString" : "tell application \"BetterTouchTool\" to set dndEnabled to get_number_variable \"SystemDoNotDisturbState\"\r\rif dndEnabled is 0 then\r\ttell application \"BetterTouchTool\"\r\t\tset badgeNumber to get_dock_badge_for \"Messages\" update_interval 5\r\t\tset handoffDevice to get_dock_badge_for \"Messages-handoff\" update_interval 5\r\tend tell\r\tif badgeNumber is not missing value and handoffDevice is missing value then\r\t\ttell application \"BetterTouchTool\"\r\t\t\tif is_app_running \"Messages\" then\r\t\t\t\treturn badgeNumber\r\t\t\telse\r\t\t\t\treturn \"\"\r\t\t\tend if\r\t\tend tell\r\telse if handoffDevice is not missing value then\r\t\tif handoffDevice contains \"iPhone\" then\r\t\t\treturn \"iPhone\"\r\t\telse if handoffDevice contains \"iPad\" then\r\t\t\treturn \"iPad\"\r\t\telse if handoffDevice contains \"watch\" then\r\t\t\treturn \"Watch\"\r\t\telse if handoffDevice contains \"Mac\" then\r\t\t\treturn \"Mac\"\r\t\tend if\r\telse\r\t\treturn \"\"\r\tend if\relse\r\treturn \"\"\rend if",
      "BTTTouchBarItemPadding" : -8
    }
  },
