        "BTTPredefinedActionType" : 397,
        "BTTPredefinedActionName" : "Load New HTML Or URL For Web View Menu Item",
        "BTTAdditionalActionData" : {
          "BTTMenuActionMenuItemContentHTML" : "<style>\n  .touchbar-container { display: flex; flex-direction: column; font-family: 'YourChosenMonospaceFont', monospace; font-size: 8px; line-height: 1.2; }\n  .row { display: flex; flex-direction: row; }\n  .space-segment { margin-right: 4px; \/* Adjust spacing between S1, S2 etc. *\/ }\n  .label-part { width: 35px; \/* Fixed width for \"S1*3\", adjust as needed *\/ white-space: nowrap; }\n  .canvas-part { white-space: nowrap; }\n<\/style>\n<div class=\"touchbar-container\">\n  <div class=\"row\"> <!-- Line 0 -->\n    <div class=\"space-segment\">\n      <span class=\"label-part\">S1*3<\/span><span class=\"canvas-part\">[■■■....]<\/span>\n    <\/div>\n    <div class=\"space-segment\">\n      <span class=\"label-part\">S2*1<\/span><span class=\"canvas-part\">[...■■■.]<\/span>\n    <\/div>\n    <!-- more spaces for Line 0 -->\n  <\/div>\n  <div class=\"row\"> <!-- Line 1 -->\n    <div class=\"space-segment\">\n      <span class=\"label-part\"> <\/span> <!-- Non-breaking spaces for padding, or an empty span if label part handles width -->\n      <span class=\"canvas-part\">[...■■■.]<\/span>\n    <\/div>\n    <div class=\"space-segment\">\n      <span class=\"label-part\"> <\/span>\n      <span class=\"canvas-part\">[■■■....]<\/span>\n    <\/div>\n    <!-- more spaces for Line 1 -->\n  <\/div>\n<\/div>"
        },
