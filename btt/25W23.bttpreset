    "BTTPredefinedActionName" : "Run Apple Script (async in background)",
    "BTTInlineAppleScript" : "tell application \"BetterTouchTool\"\r\tif is_app_running \"BusyCal\" then\r\t\ttell application \"System Events\"\r\t\t\ttell process \"Dock\"\r\t\t\t\ttry\r\t\t\t\t\tclick UI element \"BusyCal\" of list 1\r\t\t\t\tend try\r\t\t\tend tell\r\t\tend tell\r\telse\r\t\ttell application \"BusyCal\" to activate\r\tend if\nend tell\n\nreturn \"\"",
    "BTTAlternateModifierKeys" : 786432,
    "BTTEnabled" : 1,
    "BTTEnabled2" : 1,
    "BTTModifierMode" : 2,
