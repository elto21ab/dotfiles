    "BTTWidgetName" : "Connect to AirPods",
    "BTTKeySequence" : {

    },
    "BTTTriggerConfig" : {
      "BTTTouchBarOnlyShowIcon" : true,
      "BTTTouchBarIconTextOffset" : 5,
      "BTTTouchBarButtonCornerRadius" : 6,
      "BTTTouchBarBringPlayerToFront" : 0,
      "BTTTouchBarItemPadding" : -13,
      "BTTTouchBarButtonColor" : "0.000000, 0.000000, 0.000000, 255.000000",
      "BTTTouchBarEmojiHideBackButton" : false,
      "BTTTouchBarItemPlacement" : 2,
      "BTTTouchBarAppleScriptStringRunOnInit" : false,
      "BTTTouchBarFontColorAlternate" : "10.000000, 132.000000, 255.000000, 255.000000",
      "BTTTouchBarAlwaysShowButton" : false,
      "BTTTouchBarHideWhenPaused" : 0,
      "BTTScriptType" : 0,
      "BTTTouchBarButtonWidth" : 100,
      "BTTTouchBarScriptUpdateInterval" : 2,
      "BTTTouchBarItemIconHeight" : 22,
      "BTTTouchBarBatteryHideOnCharging" : false,
      "BTTTouchBarButtonTextAlignment" : 0,
      "BTTTouchBarAlternateBackgroundColor" : "0.000000, 0.000000, 0.000000, 255.000000",
      "BTTTouchBarAppleScriptUsePath" : 0,
      "BTTTBWidgetWidth" : 400,
      "BTTTouchBarDefaultPlayer" : 0,
      "BTTTouchBarColorRegex" : "^true",
      "BTTTouchBarItemIconWidth" : 22,
      "BTTTouchBarLongPressActionName" : "Show Connectivity Actions",
      "BTTTouchBarHideWhenNoPlayer" : false,
      "BTTTouchBarButtonFontSize" : 15,
      "BTTTouchBarFontColor" : "255.000000, 255.000000, 255.000000, 255.000000",
      "BTTTouchBarHideCover" : 0,
      "BTTTouchBarFreeSpaceAfterButton" : 0,
      "BTTTouchBarAppleScriptString" : "use framework \"Foundation\"\ruse framework \"IOBluetooth\"\ruse scripting additions\r\rset pairedNames to ((current application's IOBluetoothDevice's pairedDevices())'s valueForKey:\"nameOrAddress\") as list\rset connectedValue to ((current application's IOBluetoothDevice's pairedDevices())'s valueForKey:\"connected\") as list\rset btInfo to {}\r\rset i to 0\rrepeat with i from 1 to count pairedNames\r\tset btInfo to btInfo & (item i of pairedNames & \", \" & item i of connectedValue) as list\rend repeat\r\rset i to 0\rset deviceConnected to false\rrepeat with i from 1 to count btInfo\r\tif item i of btInfo contains \"AirPods\" and item i of btInfo does not contain \"Pro\" and item i of btInfo does not contain \"Max\" and item i of btInfo contains \", 1\" then\r\t\tset deviceConnected to true\r\telse if item i of btInfo contains \"Temmie Flakes\" and item i of btInfo does not contain \"Deluxe\" and item i of btInfo does not contain \"XL\" and item i of btInfo contains \", 1\" then\r\t\tset deviceConnected to true\r\tend if\rend repeat\r\rreturn deviceConnected"
    }
  },
