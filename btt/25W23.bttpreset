      "BTTTouchBarButtonCornerRadius" : 0,
      "BTTTouchBarButtonColor" : "210.000003, 127.000000, 21.000001, 255.000000",
      "BTTTouchBarApplyCornerRadiusTo" : -1,
      "BTTTouchBarItemPlacement" : 2,
      "BTTTouchBarAppleScriptStringRunOnInit" : false,
      "BTTTouchBarAlwaysShowButton" : false,
      "BTTTouchBarIconInvert" : false,
      "BTTTouchBarButtonHoverColor" : "248.880000, 146.115000, 128.010000, 181.050000",
      "BTTTouchBarButtonHeight" : 15,
      "BTTTouchBarButtonWidth" : 100,
      "BTTTouchBarScriptUpdateInterval" : 2,
      "BTTTouchBarItemIconHeight" : 22,
      "BTTTouchBarButtonTextAlignment" : 0,
      "BTTShellScriptDontTrimWhitepsace" : 0,
      "BTTTouchBarAlternateBackgroundColor" : "75.323769, 75.323769, 75.323769, 255.000000",
      "BTTTouchBarItemIconType" : 1,
      "BTTTBWidgetWidth" : 400,
      "BTTTouchBarBorderColor" : "255.000000, 255.000000, 255.000000, 255.000000",
      "BTTTouchBarItemIconWidth" : 22,
      "BTTTouchBarFreeSpaceBeforeButton" : 0,
      "BTTTouchBarShellScriptString" : "    # Vertical calculations: determine which line(s) to paint\n    PAINT_ON_LINE0=false\n    PAINT_ON_LINE1=false\n    WINDOW_Y_NORM=$(echo \"scale=4; $WIN_Y \/ $SPACE_DISPLAY_H\" | $BC_PATH) # Normalized Y start\n    WINDOW_H_NORM=$(echo \"scale=4; $WIN_H \/ $SPACE_DISPLAY_H\" | $BC_PATH) # Normalized Height\n\n    # Ensure bc output is valid\n    if ! [[ \"$WINDOW_Y_NORM\" =~ ^-?[0-9]+([.,][0-9]+)?$ ]]; then WINDOW_Y_NORM=0; fi\n    if ! [[ \"$WINDOW_H_NORM\" =~ ^-?[0-9]+([.,][0-9]+)?$ ]]; then WINDOW_H_NORM=0; fi\n\n    # Heuristic:\n    # If window is fairly tall (e.g., > 60% of screen height), it's on both lines.\n    # Otherwise, if it starts in top ~55%, it's on line 0.\n    # Otherwise, if it starts below ~45%, it's on line 1.\n    # This creates a small \"dead zone\" or \"both zone\" for mid-height windows.\n\n    TALL_WINDOW_THRESHOLD=0.60  # e.g., 60% of screen height\n    TOP_HEAVY_THRESHOLD=0.55    # Starts in top 55%\n    BOTTOM_HEAVY_START=0.45 # Starts below 45% (i.e. in bottom 55%)\n\n\n    if (( $(echo \"$WINDOW_H_NORM >= $TALL_WINDOW_THRESHOLD\" | $BC_PATH -l) )); then\n      PAINT_ON_LINE0=true\n      PAINT_ON_LINE1=true\n    elif (( $(echo \"$WINDOW_Y_NORM < $TOP_HEAVY_THRESHOLD\" | $BC_PATH -l) )); then\n      PAINT_ON_LINE0=true\n    elif (( $(echo \"$WINDOW_Y_NORM >= $BOTTOM_HEAVY_START\" | $BC_PATH -l) )); then # Covers windows starting in middle to bottom\n      PAINT_ON_LINE1=true\n    else # Default to painting on both if in a middle-zone and not tall (can be adjusted)\n      PAINT_ON_LINE0=true\n      PAINT_ON_LINE1=true\n    fi",
      "BTTTouchBarButtonFontSize" : 8,
      "BTTTouchBarIconTextOffset" : 5,
      "BTTTouchBarButtonName" : "Space Indicator",
      "BTTTouchBarOnlyShowIcon" : false,
      "BTTTouchBarFreeSpaceAfterButton" : 10,
      "BTTTouchBarItemPadding" : 0
    }
