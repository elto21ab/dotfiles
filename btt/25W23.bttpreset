      "BTTTouchBarIconTextOffset" : 5,
      "BTTTouchBarAppleScriptString" : "set device to do shell script \"networksetup -listallhardwareports | awk '$3==\\\"Wi-Fi\\\" {getline;print}' | awk '{print $2}'\"\rset power to do shell script \"networksetup -getairportpower \" & device & \" | awk '{print $4}'\"\rif power is equal to \"on\" then\r\treturn \"on\"\relse\r\treturn \"off\"\rend if",
