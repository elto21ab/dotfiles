          "BTTPredefinedActionType" : 281,
          "BTTPredefinedActionName" : "Run Real JavaScript",
          "BTTAdditionalActionData" : {
            "BTTScriptType" : 3,
            "BTTScriptFunctionToCall" : "someJavaScriptFunction",
            "BTTAppleScriptRunInBackground" : false,
            "BTTTouchBarAppleScriptString" : "(async()=>{\n\tn=await get_string_variable(\"focused_window_app_name\")\n\ttrigger_named('swmfloat')\n\tset_persistent_string_variable({variable_name:'SWM-FA',to:(n==\"\")?\"\":(n+\":\"+((await get_number_variable(\"fullscreen_active\"))==1))})\n\treturnToBTT(1)\n})()",
            "BTTTouchBarAppleScriptUsePath" : false
