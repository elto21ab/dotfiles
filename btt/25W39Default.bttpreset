            {
              "BTTLastUpdatedAt" : 1748540762.81849,
              "BTTTriggerType" : 643,
              "BTTTriggerTypeDescriptionReadOnly" : "Named Trigger: SWM-MCW",
              "BTTTriggerTypeDescription" : "🚥 Mission Control Close Window Under Cursor",
              "BTTTriggerParentUUID" : "44F03F69-29EE-42BB-A288-6BA39EA8BFA4",
              "BTTTriggerClass" : "BTTTriggerTypeOtherTriggers",
              "BTTUUID" : "A6B1C737-A00E-4ED0-950C-2DC39766F434",
              "BTTPredefinedActionType" : 281,
              "BTTPredefinedActionName" : "Run Real JavaScript",
              "BTTRealJavaScriptString" : "(async()=>{\n\ta=await callBTT(\"get_string_variable\",{variableName:\"hovered_element_details\"})\n\ts=i=>(a.split('<AX'+i+': \"')[1].split('\">')[0])\n\tf=s('Application')\n\tw=s('Window')\n\t\n\trunAppleScript(`\ntell app \"System Events\"\ntry\nset p to process \"`+f+`\"\non error\nset p to (process 1 where displayed name is \"`+f+`\")\nend try\nclick (buttons whose subrole is \"AXCloseButton\") of window \"`+w+`\" of p\nend tell\n`)\n\n\treturnToBTT(1)\n\t})()",
              "BTTTriggerName" : "SWM-MCW",
              "BTTNotesInsteadOfDescription" : 1,
              "BTTRequiredModifierKeys" : 0,
              "BTTOrder" : 2,
              "BTTGestureNotes" : "🚥 Mission Control Close Window Under Cursor"
            },
            {
              "BTTLastUpdatedAt" : 1748540762.819078,
