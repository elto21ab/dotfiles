              "BTTAdditionalActionData" : {
                "BTTScriptType" : 3,
                "BTTScriptFunctionToCall" : "someJavaScriptFunction",
                "BTTAppleScriptRunInBackground" : false,
                "BTTTouchBarAppleScriptString" : "(async()=>{\nvW=await get_number_variable('mouse_screen_visible_frame_width')\nvH=await get_number_variable('mouse_screen_visible_frame_height')\nN=`tell app \"System Events\" to tell window 1 of process (name of app id \"`+(await get_string_variable(\"BTTActiveAppBundleIdentifier\"))+`\")`\n\nL=async()=>(await runAppleScript(N+` to {position,size}`)).match(\/\\d+\/g)\n\nF=await L()\nW=F[2];H=F[3];\n\nJ=JSON.parse(await get_string_variable(\"SWM-Stg\"))\n\t\t\nGS=J.GapSize\nCN=(J.MXGap+J.Gap>1)?(vW-W-GS*2<5&&vH-H-GS*2<5):(vW-W<5&&vH-H<5)\n\ntrigger_action({json:{BTTPredefinedActionType:CN?84:21}})\n\nif((J.MXGap+J.Gap>1)&&!CN){\n\trunAppleScript(N+`\n\t\tset {{W,H},{X,Y}} to {size,position}\n\t\tset {size,position} to {{W-`+2*GS+`,H-`+2*GS+`},{X+`+GS+`,Y+`+GS+`}}\n\tend tell\n\t`)\n}\n\nsetTimeout(async()=>{\n\tif((await L()).toString()==F.toString()){\n\t\tvX=await get_number_variable('mouse_screen_visible_frame_x')\n\t\tsY=await get_number_variable('mouse_screen_y')\n\t\tM=(await runAppleScript(`\n\t\t\ttell app \"System Events\"\n\t\t\t\tif (autohide menu bar of dock preferences) then return 0\n\t\t\t\treturn item 2 of (size of menu bar 1 of process \"Finder\" as list)\n\t\t\tend tell\n\t\t`))*1\n\t\trunAppleScript(N+` to set {position,size} to {{`+(vX+vW\/4)+`,`+((sY+M)+vH\/4)+`},{`+vW\/2+`,`+vH\/2+`}}`)\n\t}\n},300)\nreturnToBTT(1)\n})()",
                "BTTTouchBarAppleScriptUsePath" : false
              },
              "BTTRealJavaScriptString" : "(async()=>{\nvW=await get_number_variable('mouse_screen_visible_frame_width')\nvH=await get_number_variable('mouse_screen_visible_frame_height')\nN=`tell app \"System Events\" to tell window 1 of process (name of app id \"`+(await get_string_variable(\"BTTActiveAppBundleIdentifier\"))+`\")`\n\nL=async()=>(await runAppleScript(N+` to {position,size}`)).match(\/\\d+\/g)\n\nF=await L()\nW=F[2];H=F[3];\n\nJ=JSON.parse(await get_string_variable(\"SWM-Stg\"))\n\t\t\nGS=J.GapSize\nCN=(J.MXGap+J.Gap>1)?(vW-W-GS*2<5&&vH-H-GS*2<5):(vW-W<5&&vH-H<5)\n\ntrigger_action({json:{BTTPredefinedActionType:CN?84:21}})\n\nif((J.MXGap+J.Gap>1)&&!CN){\n\trunAppleScript(N+`\n\t\tset {{W,H},{X,Y}} to {size,position}\n\t\tset {size,position} to {{W-`+2*GS+`,H-`+2*GS+`},{X+`+GS+`,Y+`+GS+`}}\n\tend tell\n\t`)\n}\n\nsetTimeout(async()=>{\n\tif((await L()).toString()==F.toString()){\n\t\tvX=await get_number_variable('mouse_screen_visible_frame_x')\n\t\tsY=await get_number_variable('mouse_screen_y')\n\t\tM=(await runAppleScript(`\n\t\t\ttell app \"System Events\"\n\t\t\t\tif (autohide menu bar of dock preferences) then return 0\n\t\t\t\treturn item 2 of (size of menu bar 1 of process \"Finder\" as list)\n\t\t\tend tell\n\t\t`))*1\n\t\trunAppleScript(N+` to set {position,size} to {{`+(vX+vW\/4)+`,`+((sY+M)+vH\/4)+`},{`+vW\/2+`,`+vH\/2+`}}`)\n\t}\n},300)\nreturnToBTT(1)\n})()",
